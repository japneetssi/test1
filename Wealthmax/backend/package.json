{
    "name": "backend",
    "version": "1.0.0",
    "description": "WealthMax Backend API",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "migrate": "node-pg-migrate",
        "migrate:create": "node-pg-migrate create",
        "migrate:up": "node-pg-migrate up",
        "migrate:down": "node-pg-migrate down",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "nav:sync": "ts-node -r tsconfig-paths/register src/scripts/sync-nav.ts",
        "iifl:sync": "ts-node -r tsconfig-paths/register src/scripts/sync-iifl.ts"
    },
    "dependencies": {
        "@faker-js/faker": "^10.4.0",
        "@types/multer": "^2.1.0",
        "@types/pdfkit": "^0.17.5",
        "axios": "^1.13.2",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^16.3.1",
        "express": "^4.22.1",
        "helmet": "^7.1.0",
        "ioredis": "^5.9.2",
        "jsonwebtoken": "^9.0.3",
        "morgan": "^1.10.1",
        "multer": "^2.1.1",
        "node-cache": "^5.1.2",
        "node-cron": "^4.2.1",
        "node-pg-migrate": "^8.0.4",
        "nodemailer": "^7.0.13",
        "pdf-parse": "^2.4.5",
        "pdfkit": "^0.17.2",
        "pg": "^8.22.0",
        "plaid": "^43.0.0",
        "winston": "^3.11.0",
        "yahoo-finance2": "^3.13.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/dotenv": "^8.2.3",
        "@types/express": "^4.17.25",
        "@types/ioredis": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/node": "^20.19.39",
        "@types/node-cache": "^4.1.3",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^6.4.23",
        "@types/pg": "^8.10.9",
        "@types/uuid": "^11.0.0",
        "@typescript-eslint/eslint-plugin": "^6.16.0",
        "@typescript-eslint/parser": "^6.16.0",
        "eslint": "^8.56.0",
        "nodemon": "^3.1.14",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.0"
    }
}
