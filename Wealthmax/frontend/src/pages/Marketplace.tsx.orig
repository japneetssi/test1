import { useState, useMemo, useEffect } from "react";
import TopNav from "@/components/TopNav";
import SubNav from "@/components/SubNav";
import { Search, SlidersHorizontal, Star, TrendingUp, Shield, ChevronDown } from "lucide-react";
import { useToast } from "@/hooks/use-toast";

// ── Static Product Data ────────────────────────────────────────────────────────

interface Product {
    id: string;
    name: string;
    shortName: string;
    category: string;
    risk: string;
    amc: string;
    nav?: number;
    cagr3y?: number;
    cagr1y?: number;
    aum?: string;
    rating?: number;
    minSIP?: number;
    isRecommended?: boolean;
    isin?: string;
    description?: string;
    fundHouse?: string;
    riskLevel?: string;
}

const AMC_LIST = ["HDFC AMC", "SBI Funds", "ICICI Pru AMC", "Axis AMC", "Nippon AMC", "Mirae AMC", "Kotak AMC", "ABSL AMC", "PPFAS AMC", "DSP AMC", "IIFL AMC", "Bajaj Finserv", "Shriram Transport"];
const CATEGORIES = ["All", "MF", "Equity", "Insurance (Life/Term)", "Insurance (Health)", "Loan", "FD", "AIF", "PMS", "Real Estate", "Other Assets"];

// ── Component ─────────────────────────────────────────────────────────────────

export default function Marketplace() {
    const { toast } = useToast();
    const [products, setProducts] = useState<Product[]>([]);
    const [loading, setLoading] = useState(true);
    const [searchQuery, setSearchQuery] = useState("");
    const [activeCategory, setActiveCategory] = useState("All");
    const [selectedRisks, setSelectedRisks] = useState<string[]>([]);
    const [selectedAMCs, setSelectedAMCs] = useState<string[]>([]);
    const [sortBy, setSortBy] = useState<"cagr3y" | "nav" | "aum" | "rating">("cagr3y");

    useEffect(() => {
        const fetchProducts = async () => {
            try {
                const res = await fetch('http://localhost:5001/api/marketplace/catalog');
                const data = await res.json();
                if (data.success) {
                    let fetchedProducts = data.data.map((p: any) => ({
                        id: p.id,
                        name: p.name,
                        shortName: p.name.length > 20 ? p.name.substring(0, 20) + '...' : p.name,
                        category: p.category === 'Insurance' ? 'Insurance (Life/Term)' : p.category, // Map base insurance to Life for demo
                        risk: p.riskLevel,
                        amc: p.fundHouse || "General AMC",
                        nav: p.nav || 100,
                        cagr3y: p.cagr3y || Math.floor(Math.random() * 20),
                        cagr1y: p.cagr1y || Math.floor(Math.random() * 15),
                        aum: p.aum || "₹1,000 Cr",
                        rating: p.rating || 4,
                        minSIP: p.minInvestment || 500,
                        isRecommended: p.relevanceScore > 50,
                        isin: p.isin || ""
                    }));
                    
                    // Add mock products for new categories
                    const mockExtras: Product[] = [
                        { id: 'm1', name: 'Premium Commercial Space Fund', shortName: 'Comm Space Fund', category: 'Real Estate', risk: 'Moderate', amc: 'Realty Partners', nav: 5000, cagr3y: 12, aum: '₹500 Cr', rating: 4, minSIP: 100000 },
                        { id: 'm2', name: 'Global REIT Index', shortName: 'Global REIT', category: 'Real Estate', risk: 'Conservative', amc: 'Global Infra', nav: 120, cagr3y: 8, aum: '₹1200 Cr', rating: 5, minSIP: 5000 },
                        { id: 'm3', name: 'Digital Art NFT Fund', shortName: 'NFT Art Fund', category: 'Other Assets', risk: 'Aggressive', amc: 'Digital Native', nav: 10, cagr3y: 45, aum: '₹50 Cr', rating: 3, minSIP: 1000 },
                        { id: 'm4', name: 'Term Life Cover Pro 1Cr', shortName: 'Term Cover Pro', category: 'Insurance (Life/Term)', risk: 'Conservative', amc: 'SafeLife', cagr3y: 15, aum: 'N/A', rating: 4, minSIP: 15000 },
                        { id: 'm5', name: 'Health Suraksha Plus Family', shortName: 'Health Plus', category: 'Insurance (Health)', risk: 'Conservative', amc: 'HealthCare Muthoot', cagr3y: 20, aum: 'N/A', rating: 5, minSIP: 8000 },
                        { id: 'm6', name: 'AIF Alpha Returns', shortName: 'AIF Alpha', category: 'AIF', risk: 'Aggressive', amc: 'Alpha Partners', nav: 10500, cagr3y: 25, aum: '₹2000 Cr', rating: 4, minSIP: 1000000 },
                        { id: 'm7', name: 'PMS MultiCap Strategy', shortName: 'PMS MultiCap', category: 'PMS', risk: 'Moderate', amc: 'WealthMax PMS', nav: 520, cagr3y: 18, aum: '₹800 Cr', rating: 5, minSIP: 5000000 },
                    ];
                    
                    setProducts([...fetchedProducts, ...mockExtras]);
                }
            } catch (err) {
                console.error(err);
            } finally {
                setLoading(false);
            }
        };
        fetchProducts();
    }, []);

    const toggleFilter = (value: string, list: string[], setter: (v: string[]) => void) => {
        setter(list.includes(value) ? list.filter(v => v !== value) : [...list, value]);
    };

    const filtered = useMemo(() => {
        return products
            .filter(p => {
                if (searchQuery) {
                    const q = searchQuery.toLowerCase();
                    if (!p.name.toLowerCase().includes(q) && !(p.isin && p.isin.toLowerCase().includes(q)) && !(p.amc && p.amc.toLowerCase().includes(q))) return false;
                }
                
                if (activeCategory !== "All") {
                    if (p.category !== activeCategory) return false;
                }
                
                if (selectedRisks.length && !selectedRisks.includes(p.risk)) return false;
                if (selectedAMCs.length && !selectedAMCs.includes(p.amc)) return false;
                return true;
            })
            .sort((a, b) => {
                if (sortBy === "cagr3y") return (b.cagr3y || 0) - (a.cagr3y || 0);
                if (sortBy === "nav") return (b.nav || 0) - (a.nav || 0);
                if (sortBy === "rating") return (b.rating || 0) - (a.rating || 0);
                return 0;
            });
    }, [products, searchQuery, activeCategory, selectedRisks, selectedAMCs, sortBy]);

    const riskColor = (risk: string) => {
        if (risk === "Conservative") return "text-blue-700 bg-blue-100 border border-blue-200";
        if (risk === "Moderate") return "text-amber-700 bg-amber-100 border border-amber-200";
        return "text-red-700 bg-red-100 border border-red-200";
    };

    const categoryColor = (cat: string) => {
        if (cat === "Equity" || cat === "PMS" || cat === "AIF") return "bg-[#00458c]/10 text-[#00458c] border border-[#00458c]/20";
        if (cat === "Debt" || cat === "FD") return "bg-green-100 text-green-700 border border-green-200";
        if (cat.includes("Insurance") || cat === "Loan") return "bg-purple-100 text-purple-700 border border-purple-200";
        return "bg-yellow-100 text-yellow-700 border border-yellow-200";
    };

    return (
        <div className="min-h-screen bg-[image:var(--gradient-hero)] bg-cover bg-fixed flex flex-col text-gray-900 overflow-x-hidden">
            <TopNav />
            <SubNav />

            {/* Page Header */}
            <div className="bg-[image:var(--gradient-accent)] px-6 py-8 flex flex-col md:flex-row items-center justify-between gap-6 shadow-md relative overflow-hidden shrink-0">
                <div className="absolute inset-0 bg-white/5 opacity-50 backdrop-blur-3xl mix-blend-overlay"></div>
                <div className="relative z-10 w-full md:w-auto text-center md:text-left">
                    <h1 className="text-white text-3xl font-extrabold tracking-tight drop-shadow-md">Marketplace</h1>
                    <p className="text-white/90 text-sm mt-1.5 font-medium">Discover and invest in curated financial products designed for you.</p>
                </div>
                <div className="relative z-10 w-full max-w-2xl flex-1 group">
                    <Search className="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-[#00458c] opacity-60 group-focus-within:opacity-100 transition-opacity" />
                    <input
                        type="text"
                        placeholder="Search ISIN, Scrip, or Scheme Name..."
                        value={searchQuery}
                        onChange={e => setSearchQuery(e.target.value)}
                        className="w-full pl-11 pr-4 py-3 text-[15px] glass-input text-gray-900 placeholder-gray-500 font-medium"
                    />
                </div>
                <div className="relative z-10 flex items-center gap-3 w-full md:w-auto justify-end">
                    <span className="text-white/90 text-sm font-medium drop-shadow-sm">Sort by:</span>
                    <select
                        value={sortBy}
                        onChange={e => setSortBy(e.target.value as typeof sortBy)}
                        className="text-sm bg-white/20 text-white font-medium border border-white/30 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-white/50 focus:bg-white/30 transition-all cursor-pointer backdrop-blur-sm hover:bg-white/30"
                    >
                        <option value="cagr3y" className="text-gray-900">3Y CAGR</option>
                        <option value="nav" className="text-gray-900">NAV</option>
                        <option value="rating" className="text-gray-900">Rating</option>
                    </select>
                </div>
            </div>

            {/* Body */}
            <div className="flex flex-col md:flex-row flex-1 gap-6 max-w-[1600px] w-full mx-auto px-4 py-6 min-h-0">

                {/* ── Left Sidebar ── */}
                <aside className="w-full md:w-64 shrink-0 glass-panel p-5 space-y-6 md:sticky md:top-6 h-fit md:max-h-[calc(100vh-120px)] overflow-y-auto custom-scrollbar animate-enter">
                    <div className="flex items-center gap-2 text-sm font-bold text-[#00458c] uppercase tracking-wider mb-2 border-b border-gray-200/50 pb-3">
                        <SlidersHorizontal className="h-4 w-4" />
                        Filters
                    </div>

                    {/* Risk Profile */}
                    <FilterSection title="Risk Profile">
                        {(["Conservative", "Moderate", "Aggressive"] as const).map(risk => (
                            <CheckboxItem
                                key={risk}
                                label={risk}
                                checked={selectedRisks.includes(risk)}
                                onChange={() => toggleFilter(risk, selectedRisks, setSelectedRisks)}
                                count={products.filter(p => p.risk === risk && (activeCategory === "All" || p.category === activeCategory)).length}
                            />
                        ))}
                    </FilterSection>

                    {/* AMC */}
                    <FilterSection title="AMC / Fund House">
                        <div className="max-h-64 overflow-y-auto space-y-2 pr-2 custom-scrollbar">
                            {AMC_LIST.map(amc => (
                                <CheckboxItem
                                    key={amc}
                                    label={amc}
                                    checked={selectedAMCs.includes(amc)}
                                    onChange={() => toggleFilter(amc, selectedAMCs, setSelectedAMCs)}
                                    count={products.filter(p => p.amc === amc && (activeCategory === "All" || p.category === activeCategory)).length}
                                />
                            ))}
                        </div>
                    </FilterSection>

                    {/* Clear */}
                    {(selectedRisks.length + selectedAMCs.length) > 0 && (
                        <button
                            onClick={() => { setSelectedRisks([]); setSelectedAMCs([]); }}
                            className="w-full mt-4 text-sm text-[#f37920] font-bold py-2 border-2 border-[#f37920]/40 rounded-lg hover:bg-[#f37920]/10 hover:border-[#f37920]/60 transition-all active:scale-95"
                        >
                            Clear All Filters
                        </button>
                    )}
                </aside>

                {/* ── Main Grid ── */}
                <main className="flex-1 flex flex-col min-w-0">
                    
                    {/* Horizontal Tabs */}
                    <div className="w-full overflow-x-auto custom-scrollbar pb-3 mb-4 animate-enter" style={{ WebkitOverflowScrolling: 'touch' }}>
                        <div className="profile-tabs inline-flex min-w-max bg-white/40 shadow-sm border-white/60">
                            {CATEGORIES.map(cat => (
                                <button
                                    key={cat}
                                    onClick={() => setActiveCategory(cat)}
                                    aria-selected={activeCategory === cat}
                                    className="profile-tab px-4 py-2 text-[13px]"
                                >
                                    {cat}
                                </button>
                            ))}
                        </div>
                    </div>

                    <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-6 bg-white/40 backdrop-blur-md px-4 py-3 rounded-xl border border-white/50 shadow-sm animate-enter animate-delay-1 shrink-0">
                        <p className="text-sm text-gray-600 font-medium flex flex-wrap items-center gap-2">
                            Showing <span className="text-gradient-brand text-lg font-extrabold">{filtered.length}</span> products in <span className="text-[#00458c] font-bold">{activeCategory}</span>
                            {filtered.some(p => p.isRecommended) && (
                                <span className="ml-1 md:ml-3 text-[#00458c] bg-white border border-[#00458c]/20 shadow-sm px-2.5 py-1 rounded-full text-xs font-bold flex items-center gap-1.5 transition-transform hover:scale-105 cursor-default">
                                    <Star className="h-3.5 w-3.5 fill-amber-400 text-amber-400" /> {filtered.filter(p => p.isRecommended).length} Recommended
                                </span>
                            )}
                        </p>
                    </div>

                    <div className="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6 pb-8">
                        {filtered.map((product, index) => (
                            <ProductCard
                                key={product.id}
                                product={product}
                                index={index}
                                riskColor={riskColor}
                                categoryColor={categoryColor}
                                onInvest={() => toast({ title: `Initiating ${product.category}`, description: "Redirecting to setup portal..." })}
                                onFactsheet={() => toast({ title: "Factsheet", description: `Opening details for ${product.shortName}` })}
                            />
                        ))}
                        {filtered.length === 0 && (
                            <div className="col-span-1 lg:col-span-2 xl:col-span-3 flex flex-col items-center justify-center py-32 text-center glass-panel animate-enter h-full">
                                <div className="bg-white/50 p-6 rounded-full mb-4 shadow-sm">
                                    <Search className="h-12 w-12 text-gray-400" />
                                </div>
                                <p className="text-xl text-gray-600 font-bold mb-2">No products found</p>
                                <p className="text-sm text-gray-500 font-medium max-w-sm">No {activeCategory !== "All" ? activeCategory : ""} products match your current filters.</p>
                                <button 
                                    onClick={() => { setSelectedRisks([]); setSelectedAMCs([]); setSearchQuery(""); }}
                                    className="mt-6 btn-glass-secondary"
                                >
                                    Reset Filters
                                </button>
                            </div>
                        )}
                    </div>
                </main>
            </div>
        </div>
    );
}

// ── Sub-Components ─────────────────────────────────────────────────────────────

function FilterSection({ title, children }: { title: string; children: React.ReactNode }) {
    const [open, setOpen] = useState(true);
    return (
        <div className="bg-white/40 rounded-xl p-3 border border-white/60 shadow-[0_2px_10px_rgba(0,0,0,0.02)] transition-all hover:bg-white/50">
            <button
                onClick={() => setOpen(o => !o)}
                className="flex items-center justify-between w-full p-1"
            >
                <span className="text-xs font-bold text-gray-700 uppercase tracking-widest">{title}</span>
                <ChevronDown className={`h-4 w-4 text-gray-500 transition-transform duration-300 ${open ? "" : "-rotate-90"}`} />
            </button>
            {open && <div className="space-y-2 mt-3 animate-enter">{children}</div>}
        </div>
    );
}

function CheckboxItem({ label, checked, onChange, count }: { label: string; checked: boolean; onChange: () => void; count: number }) {
    return (
        <label className="flex items-center justify-between gap-3 cursor-pointer group px-1 py-1 rounded-lg transition-colors hover:bg-white/60">
            <div className="flex items-center gap-3">
                <div className="relative flex items-center justify-center">
                    <input
                        type="checkbox"
                        checked={checked}
                        onChange={onChange}
                        className="peer w-4 h-4 appearance-none border-2 border-gray-300 rounded-md checked:bg-[#00458c] checked:border-[#00458c] transition-all cursor-pointer focus:ring-2 focus:ring-[#00458c]/30 focus:outline-none"
                    />
                    <svg className="absolute w-2.5 h-2.5 text-white opacity-0 peer-checked:opacity-100 pointer-events-none transition-opacity" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 5L5 9L13 1" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/>
                    </svg>
                </div>
                <span className={`text-sm font-medium transition-colors ${checked ? "text-[#00458c] font-semibold" : "text-gray-700 group-hover:text-gray-900"}`}>{label}</span>
            </div>
            <span className={`text-xs px-2 py-0.5 rounded-full font-semibold transition-colors ${checked ? "bg-[#00458c]/10 text-[#00458c]" : "bg-gray-100 text-gray-500"}`}>{count}</span>
        </label>
    );
}

function ProductCard({ product, index, riskColor, categoryColor, onInvest, onFactsheet }: {
    product: Product;
    index: number;
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    riskColor: (r: string) => string;
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    categoryColor: (c: string) => string;
    onInvest: () => void;
    onFactsheet: () => void;
}) {
    const isFD = product.category === 'FD';
    const isLoan = product.category === 'Loan';
    const isInsurance = product.category.includes('Insurance');
    const isRealEstate = product.category === 'Real Estate';
    
    let label1 = "NAV / LTP";
    let value1 = `₹${product.nav?.toLocaleString('en-IN')}`;
    let label2 = "3Y CAGR";
    let value2 = `+${product.cagr3y}%`;
    let label3 = "1Y Returns";
    let value3 = `+${product.cagr1y}%`;

    if (isFD) {
        label1 = "Min Deposit";
        value1 = `₹${product.minSIP}`;
        label2 = "Interest p.a.";
        value2 = `${product.cagr3y}%`;
        label3 = "Tenure";
        value3 = `1-5 Yrs`;
    } else if (isLoan) {
        label1 = "Max Loan";
        value1 = `₹50L`;
        label2 = "Interest p.a.";
        value2 = `${product.cagr3y}%`;
        label3 = "Processing";
        value3 = `1%`;
    } else if (isInsurance) {
        label1 = "Cover";
        value1 = `₹1Cr`;
        label2 = "Premium";
        value2 = `₹${product.cagr3y}k/yr`;
        label3 = "Claim Ratio";
        value3 = `98%`;
    } else if (isRealEstate) {
        label1 = "Min Inv.";
        value1 = `₹${(product.minSIP || 0)/1000}k`;
        label2 = "Yield";
        value2 = `${product.cagr3y}%`;
        label3 = "Appreciation";
        value3 = `~${product.cagr1y || 10}%`;
    }

    const delayClass = `animate-delay-${(index % 5) + 1}`;

    return (
        <div className={`glass-card flex flex-col overflow-hidden animate-enter ${delayClass} hover:-translate-y-1.5 transition-all duration-300`}>
            {/* Header */}
            <div className="p-5 pb-4 border-b border-gray-100/50 bg-white/40">
                <div className="flex items-start justify-between gap-3 mb-3">
                    <h3 className="text-base font-bold text-gray-900 leading-tight line-clamp-2">{product.name}</h3>
                    {product.isRecommended && (
                        <div className="shrink-0 flex items-center justify-center bg-gradient-to-br from-amber-400 to-amber-500 text-white p-1.5 rounded-lg shadow-sm" title="Recommended for you">
                            <Star className="h-4 w-4 fill-white text-white" />
                        </div>
                    )}
                </div>
                <div className="flex items-center gap-2 flex-wrap mt-auto">
                    <span className={`text-[11px] font-bold px-2 py-1 rounded-md uppercase tracking-wide ${categoryColor(product.category)} truncate max-w-[120px]`}>{product.category}</span>
                    <span className={`text-[11px] font-bold px-2 py-1 rounded-md uppercase tracking-wide ${riskColor(product.risk)}`}>{product.risk}</span>
                    <span className="text-[12px] text-gray-500 font-semibold ml-auto">{product.amc}</span>
                </div>
            </div>

            {/* Data Grid */}
            <div className="grid grid-cols-3 divide-x divide-gray-200/50 border-b border-gray-100/50 bg-white/20">
                <DataCell label={label1} value={value1} />
                <DataCell
                    label={label2}
                    value={value2}
                    valueClass={isLoan ? "text-gray-900 font-extrabold" : "text-emerald-600 font-extrabold"}
                />
                <DataCell 
                    label={label3} 
                    value={value3} 
                    valueClass={(!isFD && !isLoan && !isInsurance && !isRealEstate && (product.cagr1y || 0) >= 20) ? "text-emerald-600 font-extrabold" : "text-gray-900 font-bold"} 
                />
            </div>

            {/* Secondary Data */}
            <div className="flex items-center justify-between px-5 py-3.5 text-xs text-gray-500 bg-white/10">
                <span className="font-medium">{isInsurance || isLoan || isRealEstate ? 'Details' : 'AUM'}: <span className="font-bold text-gray-800">{isInsurance ? 'Check T&C' : isLoan ? 'Quick Disbursal' : isRealEstate ? 'Prime Location' : product.aum}</span></span>
                <span className="font-medium">{isInsurance || isLoan || isFD || isRealEstate ? 'Min Amt' : 'Min SIP'}: <span className="font-bold text-gray-800">₹{product.minSIP}</span></span>
                <div className="flex items-center gap-0.5 ml-2 bg-white/60 px-1.5 py-0.5 rounded-full border border-gray-100">
                    {Array.from({ length: 5 }).map((_, i) => (
                        <Star
                            key={i}
                            className={`h-3 w-3 ${i < (product.rating || 0) ? "text-amber-400 fill-amber-400" : "text-gray-300"}`}
                        />
                    ))}
                </div>
            </div>

            {/* Footer Buttons */}
            <div className="flex gap-3 p-5 pt-4 mt-auto bg-white/30">
                <button
                    onClick={onFactsheet}
                    className="flex-1 btn-glass-secondary justify-center text-sm py-2"
                >
                    View Details
                </button>
                <button
                    onClick={onInvest}
                    className="flex-1 btn-glass-primary justify-center text-sm py-2"
                >
                    <TrendingUp className="h-4 w-4" />
                    {isLoan ? 'Apply Now' : isInsurance ? 'Get Quote' : 'Invest Now'}
                </button>
            </div>
        </div>
    );
}

function DataCell({ label, value, valueClass = "text-gray-900 font-bold" }: { label: string; value: string; valueClass?: string }) {
    return (
        <div className="flex flex-col items-center py-4 px-2 text-center group">
            <span className="text-[10px] text-gray-500 uppercase tracking-widest font-bold mb-1.5 group-hover:text-[#00458c] transition-colors">{label}</span>
            <span className={`text-[15px] ${valueClass} drop-shadow-sm truncate w-full`}>{value}</span>
        </div>
    );
}
