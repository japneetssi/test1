# Server Configuration
NODE_ENV=development
PORT=5000

# ─── DEMO LOGIN (temporary) ──────────────────────────────────────────────────
# Seeds a demo account (migration 1790000000000). Login identifiers below
# accept the fixed demo OTP only; every other account uses crypto-random OTPs.
# Development: enabled unless DEMO_LOGIN_ENABLED=false
# Production : enabled ONLY if DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=demo@wealthmax.app
DEMO_MOBILE=+919999999999
DEMO_OTP=123456
# ─────────────────────────────────────────────────────────────────────────────

# Database Configuration (Supabase PostgreSQL)
# Get this from Supabase: Project Settings > Database > Connection String (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres

# CORS Configuration
# Update this to match your frontend URL (currently running on port 5174)
CORS_ORIGIN=http://localhost:5174

# JWT Configuration
# Generate a secure random string for production
# For development, you can use any string
JWT_SECRET=dev_secret_key_change_in_production_12345

# Encryption Configuration
# Must be exactly 32 characters for AES-256
# Generate a random 32-character string for production
ENCRYPTION_KEY=01234567890123456789012345678901

# Supabase Configuration (Optional - for future use)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email Configuration (for OTP verification)
# For Gmail: Use your Gmail address and an App Password (not your regular password)
# Generate App Password: Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=WealthMax <noreply@wealthmax.com>

# Logging
LOG_LEVEL=debug

# Redis Configuration (Optional - for caching)
# If not provided, in-memory cache will be used
REDIS_URL=redis://localhost:6379

# Mutual Fund API (Phase 2)
# Default: https://api.mfapi.in (free, no auth required)
MFAPI_BASE_URL=https://api.mfapi.in

# Broker integration (IIFL) - NEVER commit real keys. Rotate any previously leaked keys.
IIFL_APP_KEY=your_iifl_app_key
IIFL_APP_SECRET_KEY=your_iifl_app_secret_key

# Database pool tuning (optional, production scale)
# DB_POOL_MAX=100
# Set to "false" ONLY if your DB host uses self-signed certificates
# DB_SSL_REJECT_UNAUTHORIZED=true
