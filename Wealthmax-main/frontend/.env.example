# NOTE: Never commit real credentials here. All secrets live in your own untracked
# `.env` file. Rotate any key that was previously committed (Supabase, Gemini, IIFL).
VITE_SUPABASE_PROJECT_ID="your_supabase_project_ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_API_BASE_URL="http://localhost:5000/api/v1"
VITE_GEMINI_API_KEY="your_gemini_api_key"